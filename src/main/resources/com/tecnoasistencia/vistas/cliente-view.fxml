<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="680.0" prefWidth="1020.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tecnoasistencia.controlador.ClienteController">

    <!-- Encabezado Superior -->
    <top>
        <VBox fx:id="headerBox" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <VBox spacing="3.0">
                            <children>
                                <Label fx:id="lblEmpresa" text="TecnoAsistencia Nicaragua S.A."/>
                                <Label fx:id="lblTitulo" text="Módulo de Gestión de Clientes"/>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="14.0" left="24.0" right="24.0" top="14.0"/>
                    </padding>
                </HBox>
                <Separator/>
            </children>
        </VBox>
    </top>

    <!-- Contenido Principal: Formulario a la izquierda y Tabla con Búsqueda a la derecha -->
    <center>
        <HBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <children>
                <!-- Panel Izquierdo: Formulario CRUD -->
                <VBox fx:id="panelFormulario" prefWidth="380.0" minWidth="340.0" spacing="15.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                    </padding>
                    <children>
                        <Label fx:id="lblFormTitulo" text="Formulario de Clientes"/>
                        <Label fx:id="lblFormSubtitulo" text="Ingrese o modifique la información del cliente."/>
                        <Separator/>

                        <GridPane hgap="10.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="NEVER" minWidth="80.0" prefWidth="85.0"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="30.0"/>
                                <RowConstraints minHeight="35.0"/>
                                <RowConstraints minHeight="35.0"/>
                                <RowConstraints minHeight="35.0"/>
                                <RowConstraints minHeight="35.0"/>
                                <RowConstraints minHeight="30.0"/>
                            </rowConstraints>
                            <children>
                                <Label fx:id="lblId" text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtId" editable="false" promptText="Auto-generado"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label fx:id="lblNombres" text="Nombres: *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtNombres" promptText="Nombres del cliente"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label fx:id="lblApellidos" text="Apellidos: *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtApellidos" promptText="Apellidos del cliente"
                                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label fx:id="lblTelefono" text="Teléfono: *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtTelefono" promptText="Ej. +505 8888-1234"
                                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label fx:id="lblCorreo" text="Correo: *" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com"
                                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                <Label fx:id="lblEstado" text="Estado:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                <CheckBox fx:id="chkActivo" text="Cliente Activo" selected="true"
                                          GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                            </children>
                        </GridPane>

                        <Separator/>

                        <!-- Botones de Acción -->
                        <VBox spacing="10.0">
                            <children>
                                <HBox spacing="10.0" alignment="CENTER">
                                    <children>
                                        <Button fx:id="btnGuardar" text="Guardar" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                onAction="#handleGuardar"/>
                                        <Button fx:id="btnActualizar" text="Actualizar" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                onAction="#handleActualizar"/>
                                    </children>
                                </HBox>
                                <HBox spacing="10.0" alignment="CENTER">
                                    <children>
                                        <Button fx:id="btnEliminar" text="Eliminar" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                onAction="#handleEliminar"/>
                                        <Button fx:id="btnLimpiar" text="Limpiar" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                                onAction="#handleLimpiar"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Panel Derecho: Búsqueda y TableView -->
                <VBox fx:id="panelTabla" spacing="15.0" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                    </padding>
                    <children>
                        <!-- Barra de Búsqueda -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="lblBuscar" text="Búsqueda:"/>
                                <TextField fx:id="txtBuscar" promptText="Buscar por nombres, apellidos o correo..."
                                           HBox.hgrow="ALWAYS" onAction="#handleBuscar"/>
                                <Button fx:id="btnBuscar" text="Buscar" onAction="#handleBuscar"/>
                                <Button fx:id="btnLimpiarBusqueda" text="Restablecer" onAction="#handleLimpiarBusqueda"/>
                            </children>
                        </HBox>

                        <Separator/>

                        <!-- Tabla de Clientes -->
                        <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="60.0" text="ID"/>
                                <TableColumn fx:id="colNombres" prefWidth="140.0" text="Nombres"/>
                                <TableColumn fx:id="colApellidos" prefWidth="140.0" text="Apellidos"/>
                                <TableColumn fx:id="colTelefono" prefWidth="110.0" text="Teléfono"/>
                                <TableColumn fx:id="colCorreo" prefWidth="190.0" text="Correo Electrónico"/>
                                <TableColumn fx:id="colActivo" prefWidth="85.0" text="Estado"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>

                        <!-- Barra de Estado Inferior -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label fx:id="lblContador" text="Total de clientes: 0"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
